# Copy to .env for local runs:  cp .env.example .env
# --- Postgres ---
POSTGRES_USER=cogniguard
POSTGRES_PASSWORD=cogniguard_dev_pw
POSTGRES_DB=cogniguard
DATABASE_URL=postgresql+psycopg://cogniguard:cogniguard_dev_pw@postgres:5432/cogniguard

# --- Redis (online feature store) ---
REDIS_URL=redis://redis:6379/0

# --- Kafka ---
KAFKA_BOOTSTRAP=kafka:9092

# --- S3 / MinIO (data lake + model store) ---
S3_ENDPOINT=http://minio:9000
S3_BUCKET=cogniguard
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- Auth / integrity ---
JWT_SECRET=change_me_dev_only_super_secret
JWT_ALG=HS256
JWT_TTL_MINUTES=30

# --- ML ---
MODEL_DIR=/models

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
RUN_MIGRATIONS_ON_START=true
RUN_SEED_ON_START=true
LOGIN_LATENCY_BUDGET_MS=300
PAYMENT_LATENCY_BUDGET_MS=500

# --- Frontend (Vite) ---
VITE_API_BASE=http://localhost:8000
VITE_WS_BASE=ws://localhost:8000
# web-app: dev-only signing secret mirroring JWT_SECRET above (behavior-sdk's known
# client-side-secret simplification, see PROGRESS.md) -- never the real secret in prod.
VITE_SIGNING_SECRET=change_me_dev_only_super_secret
