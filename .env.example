# Copy this file to .env before running:  cp .env.example .env
# Lines starting with # are comments. Never commit .env to git.

# ── PostgreSQL (OLTP system of record) ───────────────────────────────────────
POSTGRES_USER=cogniguard
POSTGRES_PASSWORD=cogniguard_dev_pw
POSTGRES_DB=cogniguard
DATABASE_URL=postgresql+psycopg://cogniguard:cogniguard_dev_pw@postgres:5432/cogniguard

# ── Redis (online feature store — hot path only) ─────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Kafka (event streaming, KRaft mode) ──────────────────────────────────────
KAFKA_BOOTSTRAP=kafka:9092

# ── S3 / MinIO (data lake + model artifact store) ────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_BUCKET=cogniguard
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# ── Auth / integrity ──────────────────────────────────────────────────────────
# IMPORTANT: Change JWT_SECRET to a strong random value before any non-local use.
JWT_SECRET=change_me_dev_only_super_secret
JWT_ALG=HS256
JWT_TTL_MINUTES=30

# ── ML model directory ───────────────────────────────────────────────────────
# Bind-mounted from ./models at repo root into the gateway container.
MODEL_DIR=/models

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=INFO
# Auto-run Alembic migrations on gateway startup
RUN_MIGRATIONS_ON_START=true
# Auto-seed demo personas, policy, and models on gateway startup
RUN_SEED_ON_START=true
# Latency budgets (milliseconds, p95 targets per PRD)
LOGIN_LATENCY_BUDGET_MS=300
PAYMENT_LATENCY_BUDGET_MS=500

# ── SMTP — OTP / step-up email delivery (optional) ───────────────────────────
# Leave blank to skip email OTP; dev OTP fallback is always 123456.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com

# ── Groq — LLM-powered case investigation explanations (optional) ─────────────
# Leave blank to use SHAP-only explanations (no LLM call).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ── Frontend (Vite build-time env vars) ──────────────────────────────────────
VITE_API_BASE=http://localhost:8000
VITE_WS_BASE=ws://localhost:8000
# Dev-only: mirrors JWT_SECRET for the behavior-sdk's client-side signing.
# IMPORTANT: Change to match JWT_SECRET. Never expose the real secret in a
# browser-accessible bundle in production — use a separate signing endpoint.
VITE_SIGNING_SECRET=change_me_dev_only_super_secret
# Legacy admin token field (superseded by admin JWT from POST /api/v1/admin/login)
VITE_ADMIN_TOKEN=change_me_dev_only_super_secret
