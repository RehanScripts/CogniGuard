<?xml version="1.0" encoding="utf-8"?>
<!-- Dummy face-auth overlay for very_high risk: front camera preview + status text.
     No capture or storage — closed automatically after 2 s with RESULT_OK. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/facePreviewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Dimmed overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <!-- CBI-branded face-scan UI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!-- Circular scan ring (simple View stand-in for the demo) -->
        <View
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:background="@drawable/bg_face_scan_ring" />

        <TextView
            android:id="@+id/faceStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Verifying your identity…"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Face scan in progress. Please look at the camera."
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:gravity="center" />

    </LinearLayout>
</FrameLayout>
