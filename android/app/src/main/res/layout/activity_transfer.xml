<?xml version="1.0" encoding="utf-8"?>
<!-- Parity with web-app/src/pages/Payment.tsx (Implementation.md Phase 18): beneficiary
     VPA, amount, send button, risk/action result line, and a single combined notice
     line for whichever txn_controls fired (coercion check / manual amount / cooling);
     the native demo's deliberately simpler stand-in for Payment.tsx's three separate
     interactive components (CoercionCheck/ManualAmountEntry/CoolingNotice), which this
     module doesn't reimplement as native widgets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cbi_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/cbi_primary"
        android:padding="16dp">

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_logo_circle"
            android:gravity="center"
            android:text="CB"
            android:textColor="@color/cbi_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transfer money"
            android:textColor="@color/cbi_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/beneficiaryInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Beneficiary VPA (payee@upi)"
            android:inputType="text" />

        <EditText
            android:id="@+id/amountInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Amount (INR)"
            android:inputType="numberDecimal" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/cbi_primary"
            android:text="Send"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/cbi_text" />

        <TextView
            android:id="@+id/controlsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/warning_amber" />
    </LinearLayout>
</LinearLayout>
