<?xml version="1.0" encoding="utf-8"?>
<!-- Parity with web-app/src/pages/Payment.tsx (Implementation.md Phase 18): beneficiary
     VPA, amount, send button, risk/action result line, and a control panel for whichever
     txn_controls fired. coercionPanel/manualAmountPanel mirror CoercionCheck.tsx and
     ManualAmountEntry.tsx, resolved locally against the same scorePayment response with
     no second backend call; cooling_until stays a plain notice line since CoolingNotice.tsx
     has no confirm action either, it's just a hold. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cbi_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/cbi_primary"
        android:padding="16dp">

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_logo_circle"
            android:gravity="center"
            android:text="CB"
            android:textColor="@color/cbi_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transfer money"
            android:textColor="@color/cbi_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/beneficiaryInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Beneficiary VPA (payee@upi)"
            android:inputType="text" />

        <EditText
            android:id="@+id/amountInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Amount (INR)"
            android:inputType="numberDecimal" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/cbi_primary"
            android:text="Send"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/cbi_text" />

        <TextView
            android:id="@+id/controlsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/warning_amber" />

        <LinearLayout
            android:id="@+id/coercionPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/coercionPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/cbi_accent"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/coercionCancelButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/cbi_accent"
                    android:text="Cancel -- I'm being told what to do"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/coercionConfirmButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="No, this is genuinely me" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/manualAmountPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Please re-type the amount to confirm this transfer."
                android:textColor="@color/warning_amber"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/manualAmountInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Re-enter amount (INR)"
                android:inputType="numberDecimal" />

            <Button
                android:id="@+id/confirmAmountButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/cbi_primary"
                android:text="Confirm amount"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
