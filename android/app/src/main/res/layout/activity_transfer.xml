<?xml version="1.0" encoding="utf-8"?>
<!-- Parity with web-app/src/pages/Payment.tsx (Implementation.md Phase 18): beneficiary
     VPA, amount, send button, risk/action result line, and a single combined notice
     line for whichever txn_controls fired (coercion check / manual amount / cooling);
     the native demo's deliberately simpler stand-in for Payment.tsx's three separate
     interactive components (CoercionCheck/ManualAmountEntry/CoolingNotice), which this
     module doesn't reimplement as native widgets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Transfer money"
        android:textSize="22sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/beneficiaryInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Beneficiary VPA (payee@upi)"
        android:inputType="text" />

    <EditText
        android:id="@+id/amountInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Amount (INR)"
        android:inputType="numberDecimal" />

    <Button
        android:id="@+id/sendButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Send" />

    <TextView
        android:id="@+id/resultText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/controlsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#B36B00" />
</LinearLayout>
