<resources>
    <style name="Theme.CogniGuardDemo" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/cbi_primary</item>
        <item name="colorPrimaryDark">@color/cbi_primary_dark</item>
        <item name="colorAccent">@color/cbi_accent</item>
        <item name="colorSecondary">@color/cbi_accent</item>
        <item name="android:windowBackground">@color/cbi_surface</item>
        <item name="android:textColorPrimary">@color/cbi_text</item>
    </style>

    <!-- Pill-shaped primary action button (Heritage-reference parity): full-rounded
         corners on a MaterialButton, reused by every "primary CTA" button across
         Login/Dashboard/Transfer/etc instead of repeating app:cornerRadius inline. -->
    <style name="Widget.CogniGuard.PillButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">24dp</item>
        <item name="backgroundTint">@color/cbi_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Same pill shape, used for the destructive/accent actions (e.g. coercion "Cancel"). -->
    <style name="Widget.CogniGuard.PillButton.Accent" parent="Widget.CogniGuard.PillButton">
        <item name="backgroundTint">@color/cbi_accent</item>
    </style>

    <!-- Outlined pill variant for secondary actions (e.g. "No, this is genuinely me"). -->
    <style name="Widget.CogniGuard.PillButton.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">24dp</item>
        <item name="strokeColor">@color/cbi_divider</item>
        <item name="android:textColor">@color/cbi_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Rounded-corner card surface, used by elevated panels (coercion/manual-limit/etc). -->
    <style name="Widget.CogniGuard.RoundedCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
    </style>
</resources>
