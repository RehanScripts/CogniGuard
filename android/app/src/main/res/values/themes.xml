<resources>
    <!-- Material Design 3 light theme — maps Central Bank of India color tokens to M3
         color roles. Parent changed from MaterialComponents to Material3. -->
    <style name="Theme.CogniGuardDemo" parent="Theme.Material3.Light.NoActionBar">
        <!-- M3 primary color roles -->
        <item name="colorPrimary">@color/cbi_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/cbi_primary_light</item>
        <item name="colorOnPrimaryContainer">@color/cbi_primary</item>
        <!-- M3 secondary (accent) color roles -->
        <item name="colorSecondary">@color/cbi_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/cbi_accent_light</item>
        <item name="colorOnSecondaryContainer">@color/cbi_accent</item>
        <!-- M3 surface and background roles -->
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/cbi_text</item>
        <item name="colorSurfaceVariant">@color/cbi_neutral_light</item>
        <item name="colorOnSurfaceVariant">@color/cbi_text_muted</item>
        <item name="colorOutline">@color/cbi_divider</item>
        <item name="android:colorBackground">@color/cbi_surface</item>
        <item name="android:windowBackground">@color/cbi_surface</item>
        <item name="android:textColorPrimary">@color/cbi_text</item>
    </style>

    <!-- Pill-shaped primary action button using M3 parent. Full-rounded corners,
         primary blue background, used as the main CTA across all screens. -->
    <style name="Widget.CogniGuard.PillButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">24dp</item>
        <item name="backgroundTint">@color/cbi_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Destructive/accent variant — same pill shape, red background. -->
    <style name="Widget.CogniGuard.PillButton.Accent" parent="Widget.CogniGuard.PillButton">
        <item name="backgroundTint">@color/cbi_accent</item>
    </style>

    <!-- Outlined pill variant for secondary actions. -->
    <style name="Widget.CogniGuard.PillButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">24dp</item>
        <item name="strokeColor">@color/cbi_divider</item>
        <item name="android:textColor">@color/cbi_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Tonal button (M3 tonal variant) for secondary actions. -->
    <style name="Widget.CogniGuard.TonalButton" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Flat M3 card with 1dp outline — used by elevated panels throughout. -->
    <style name="Widget.CogniGuard.RoundedCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/cbi_divider</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
